<userTask id="b2_N20" name="Tocar em «Tomei»"><incoming>SF19</incoming><outgoing>SF22</outgoing></userTask>
<userTask id="b2_N21" name="Tocar em «Adiar 10 min»"><incoming>SF20</incoming><outgoing>SF23</outgoing></userTask>
<endEvent id="b2_N22" name="Lembrete ignorado"><incoming>SF21</incoming></endEvent>
