<collaboration id="b2_Collab_1">
<participant id="b2_P1" name="Cuidador"/>
<participant id="b2_P2" name="Aplicação" processRef="b2_Proc2"/>
<participant id="b2_P3" name="Utente" processRef="b2_Proc3"/>
<messageFlow id="b2_MF1" name="Lembrete" sourceRef="b2_N2" targetRef="b2_N17"/>
<messageFlow id="b2_MF2" name="Aviso de toma não confirmada" sourceRef="b2_N7" targetRef="b2_P1"/>
<messageFlow id="b2_MF3" name="Toma confirmada" sourceRef="b2_N20" targetRef="b2_N10"/>
<messageFlow id="b2_MF4" name="Adiar 10 minutos" sourceRef="b2_N21" targetRef="b2_N14"/>
</collaboration>
<process id="b2_Proc2" isExecutable="false">
<startEvent id="b2_N1" name="Chega a hora da toma"><outgoing>SF1</outgoing><timerEventDefinition/></startEvent>
<sendTask id="b2_N2" name="Enviar lembrete"><incoming>SF1</incoming><incoming>SF16</incoming><outgoing>SF2</outgoing></sendTask>
<eventBasedGateway id="b2_N3" name=""><incoming>SF2</incoming><outgoing>SF3</outgoing><outgoing>SF9</outgoing><outgoing>SF13</outgoing></eventBasedGateway>
<intermediateCatchEvent id="b2_N4" name="Prazo de 30 min sem resposta"><incoming>SF3</incoming><outgoing>SF4</outgoing><timerEventDefinition/></intermediateCatchEvent>
<serviceTask id="b2_N5" name="Registar toma não confirmada"><incoming>SF4</incoming><outgoing>SF5</outgoing></serviceTask>
<exclusiveGateway id="b2_N6" name="Há cuidador com telemóvel?"><incoming>SF5</incoming><outgoing>SF6</outgoing><outgoing>SF8</outgoing></exclusiveGateway>
<sendTask id="b2_N7" name="Enviar WhatsApp ao cuidador"><incoming>SF6</incoming><outgoing>SF7</outgoing></sendTask>
<endEvent id="b2_N8" name="Cuidador avisado"><incoming>SF7</incoming></endEvent>
<endEvent id="b2_N9" name="Toma não confirmada"><incoming>SF8</incoming></endEvent>
<intermediateCatchEvent id="b2_N10" name="Confirmação recebida"><incoming>SF9</incoming><outgoing>SF10</outgoing><messageEventDefinition/></intermediateCatchEvent>
<serviceTask id="b2_N11" name="Registar toma como tomada"><incoming>SF10</incoming><outgoing>SF11</outgoing></serviceTask>
<serviceTask id="b2_N12" name="Somar pontos"><incoming>SF11</incoming><outgoing>SF12</outgoing></serviceTask>
<endEvent id="b2_N13" name="Toma registada"><incoming>SF12</incoming></endEvent>
<intermediateCatchEvent id="b2_N14" name="Pedido de adiamento"><incoming>SF13</incoming><outgoing>SF14</outgoing><messageEventDefinition/></intermediateCatchEvent>
<serviceTask id="b2_N15" name="Registar toma como adiada"><incoming>SF14</incoming><outgoing>SF15</outgoing></serviceTask>
<intermediateCatchEvent id="b2_N16" name="10 minutos"><incoming>SF15</incoming><outgoing>SF16</outgoing><timerEventDefinition/></intermediateCatchEvent>
