<collaboration id="b3_Collab_1">
<participant id="b3_P1" name="Utente" processRef="b3_Proc1"/>
<participant id="b3_P2" name="Aplicação" processRef="b3_Proc2"/>
<messageFlow id="b3_MF1" name="Quiz escolhido" sourceRef="b3_N2" targetRef="b3_N11"/>
<messageFlow id="b3_MF2" name="Respostas" sourceRef="b3_N3" targetRef="b3_N12"/>
<messageFlow id="b3_MF3" name="Perguntas e explicações" sourceRef="b3_N12" targetRef="b3_N3"/>
<messageFlow id="b3_MF4" name="Pontos e resultado" sourceRef="b3_N14" targetRef="b3_N4"/>
<messageFlow id="b3_MF5" name="Recompensa escolhida" sourceRef="b3_N7" targetRef="b3_N16"/>
<messageFlow id="b3_MF6" name="Código da recompensa" sourceRef="b3_N17" targetRef="b3_N8"/>
</collaboration>
<process id="b3_Proc1" isExecutable="false">
<startEvent id="b3_N1" name="Quer aprender"><outgoing>SF1</outgoing></startEvent>
<userTask id="b3_N2" name="Escolher quiz"><incoming>SF1</incoming><outgoing>SF2</outgoing></userTask>
<subProcess id="b3_N3" name="Responder às perguntas"><incoming>SF2</incoming><outgoing>SF3</outgoing></subProcess>
