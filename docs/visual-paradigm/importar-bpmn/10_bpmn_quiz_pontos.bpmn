<userTask id="b3_N5" name="Ver pontos e resultado"><incoming>SF4</incoming><outgoing>SF5</outgoing></userTask>
<exclusiveGateway id="b3_N6" name="Quer trocar pontos?"><incoming>SF5</incoming><outgoing>SF6</outgoing><outgoing>SF9</outgoing></exclusiveGateway>
<userTask id="b3_N7" name="Escolher recompensa"><incoming>SF6</incoming><outgoing>SF7</outgoing></userTask>
<intermediateCatchEvent id="b3_N8" name="Código recebido"><incoming>SF7</incoming><outgoing>SF8</outgoing><messageEventDefinition/></intermediateCatchEvent>
<endEvent id="b3_N9" name="Recompensa obtida"><incoming>SF8</incoming></endEvent>
<endEvent id="b3_N10" name="Quiz concluído"><incoming>SF9</incoming></endEvent>
<sequenceFlow id="b3_SF1" name="" sourceRef="b3_N1" targetRef="b3_N2"/>
