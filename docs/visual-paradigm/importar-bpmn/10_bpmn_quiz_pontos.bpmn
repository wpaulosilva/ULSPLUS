<sequenceFlow id="b3_SF9" name="Não" sourceRef="b3_N6" targetRef="b3_N10"/>
</process>
<process id="b3_Proc2" isExecutable="false">
<startEvent id="b3_N11" name="Quiz escolhido"><outgoing>SF10</outgoing><messageEventDefinition/></startEvent>
<subProcess id="b3_N12" name="Corrigir e explicar as respostas"><incoming>SF10</incoming><outgoing>SF11</outgoing></subProcess>
<serviceTask id="b3_N13" name="Somar pontos e guardar resultado"><incoming>SF11</incoming><outgoing>SF12</outgoing></serviceTask>
<sendTask id="b3_N14" name="Enviar resultado"><incoming>SF12</incoming><outgoing>SF13</outgoing></sendTask>
<endEvent id="b3_N15" name="Resultado enviado"><incoming>SF13</incoming></endEvent>
<startEvent id="b3_N16" name="Recompensa escolhida"><outgoing>SF14</outgoing><messageEventDefinition/></startEvent>
<sendTask id="b3_N17" name="Descontar pontos e enviar código"><incoming>SF14</incoming><outgoing>SF15</outgoing></sendTask>
<endEvent id="b3_N18" name="Recompensa entregue"><incoming>SF15</incoming></endEvent>
